# App branding — shown in title bar, splash screen, top bar, and about page
APP_NAME=StreamApp

# TorBox API — https://torbox.app/settings
TORBOX_API_KEY=your_torbox_api_key_here

# TMDB API — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# OpenSubtitles (optional) — https://opensubtitles.com/consumers
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_APP=HarizStream v1

# Server
PORT=3000
HOST=0.0.0.0

# Stremio addon URLs — configure at each provider's /configure page
# Torrentio — https://torrentio.strem.fun/configure
TORRENTIO_URL=https://torrentio.strem.fun

# Comet — https://comet.elfhosted.com/configure (paste your full configured URL)
COMET_URL=

# MediaFusion — https://mediafusion.elfhosted.com/configure
# MEDIAFUSION_URL=

# Your dynamic catalog addon
CATALOG_URL=http://localhost:7000
