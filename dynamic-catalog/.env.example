# Gemini API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# TMDB API key — https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key

# Server
PORT=7000
HOST=0.0.0.0

# Your public URL (for Stremio to reach the addon)
# e.g. https://your-gcp-domain.com or http://YOUR_GCP_IP:7000
PUBLIC_URL=http://localhost:7000

# Daily refresh time (24h format, server timezone)
REFRESH_HOUR=4
REFRESH_MINUTE=0

# Number of catalogs to generate
CATALOG_COUNT=50

# Movies per catalog
MOVIES_PER_CATALOG=20
